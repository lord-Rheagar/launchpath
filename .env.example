# Set either OPENROUTER_API_KEY or DEEPSEEK_API_KEY. Never put keys in browser code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Used only after primary failure; set to none to disable.
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.6-flash
MODEL_MAX_ATTEMPTS=2
MAX_MODEL_REQUESTS=32
MAX_FALLBACK_REQUESTS=16
# OpenRouter's Exa search is charged to the same key. No separate search key needed.
OPENROUTER_SEARCH_ENGINE=exa

# Optional: independent search and advanced extraction for unreadable public pages.
# auto uses Tavily when its key exists, otherwise the existing model search.
# model keeps model search while still allowing Tavily extraction as a fallback.
TAVILY_API_KEY=
SEARCH_PROVIDER=auto
MAX_TAVILY_REQUESTS=6
RETRIEVAL_TIMEOUT_MS=35000
# Reserved within MAX_SEARCHES/MAX_PAGES, not additional to those limits.
COVERAGE_SEARCHES=2
COVERAGE_PAGES=3

# Alternative: direct DeepSeek model + its Search/Fetch APIs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# auto prefers OpenRouter when its key is set. Set openrouter or deepseek explicitly.
AI_PROVIDER=auto

PORT=3000
HOST=127.0.0.1
# Persistent directory. Mount a durable disk here for deployment; use one server instance.
DATA_DIR=./data
RESEARCH_TIMEOUT_MS=600000
MODEL_TIMEOUT_MS=300000
MAX_SEARCHES=4
MAX_PAGES=8
MAX_AGENT_TURNS=8
# Optional: leave blank for password-free research; set to restrict generation.
RESEARCH_PASSWORD=
